# ============================================
# 模型运行模式
# "api"   = 使用远程 API（DeepSeek/千问）
# "local" = 使用本地 Ollama 模型（无需 API Key）
# ============================================
MODEL_MODE=api

# 模型提供商选择: deepseek / qwen
MODEL_PROVIDER=deepseek

# === DeepSeek API 配置（MODEL_PROVIDER=deepseek 时必填）===
# DS_API_KEY=your_deepseek_api_key_here
DS_BASE_URL=https://api.deepseek.com/v1

# === 千问 (Qwen) API 配置（MODEL_PROVIDER=qwen 时必填）===
# QWEN_API_KEY=your_qwen_api_key_here
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_FLASH_MODEL=qwen-turbo
# QWEN_PRO_MODEL=qwen-plus

# 阿里云百炼（兜底供应商1）
# ALI_API_KEY=your_aliyun_api_key_here
# ALI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 火山引擎（兜底供应商2）
# VOLC_API_KEY=your_volc_api_key_here
# VOLC_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# === Ollama 本地模型配置（MODEL_MODE=local 时必填）===
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_CHAT_MODEL=qwen3:8b
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_EMBED_DIM=768
# OLLAMA_MAX_TOKENS=4096

# === 安全配置 ===
# API 认证密钥（生产环境必填）。客户端需在 Authorization 请求头中携带 Bearer token。
# 未设置时（空值）认证功能自动关闭，仅建议在开发环境使用。
# API_KEY=sk-your-api-key-here

# 多用户模式：身份和角色仅由服务端配置决定，启用后不再接受共享 API_KEY。
# 每人使用独立随机令牌，在网页账号面板登录；不要将此配置提交到仓库。
# AUTH_USERS_JSON=[{"token":"replace-with-a-random-token-at-least-24-chars","user_id":"alice","roles":["admin"],"department":"研发"}]

# 数据根目录。本地默认仓库内 data；容器由 Compose 设置为 /app/data。
# DATA_DIR=/app/data

# 文件上传大小限制（单位 MB，默认 50MB）
# MAX_UPLOAD_SIZE_MB=50

# === 服务配置 ===
HOST=0.0.0.0
PORT=8002
RELOAD=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

ENABLE_FALLBACK_CHAT=false

# Redis
REDIS_URL=redis://localhost:6379/0

# 向量存储
VECTOR_STORE_TYPE=chroma
